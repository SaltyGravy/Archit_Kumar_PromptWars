# Smart Event Management Platform - Environment Variables Template
# Copy this file to .env and configure your Google Cloud / Firebase credentials

# Google Firebase Configuration (Deploy on Google Cloud / Firebase Hosting)
VITE_FIREBASE_API_KEY=AIzaSyExampleKey123456789
VITE_FIREBASE_AUTH_DOMAIN=smart-event-hub.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=smart-event-hub
VITE_FIREBASE_STORAGE_BUCKET=smart-event-hub.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Gemini API Key (For AI Team Matchmaking & Submission Summaries)
VITE_GEMINI_API_KEY=AIzaSyExampleGeminiKeyForAI

# Application Mode: 'live' (uses Firebase Firestore) or 'demo' (instant cross-tab multi-client simulator)
VITE_APP_MODE=demo
